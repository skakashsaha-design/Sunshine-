# Optional Third-Party Commercial Weather Provider API Keys
# Open-Meteo, MET Norway, RainViewer, USGS, NASA EONET, GDACS, and NWS Alerts
# work automatically without any API key.
# Configure these keys via the Secrets panel in AI Studio if you have accounts.

WEATHERAPI_KEY=YOUR_WEATHERAPI_KEY
ACCUWEATHER_KEY=YOUR_ACCUWEATHER_KEY
TOMORROWIO_KEY=YOUR_TOMORROWIO_KEY
WEATHERBIT_KEY=YOUR_WEATHERBIT_KEY
GOOGLE_WEATHER_API_KEY=YOUR_GOOGLE_WEATHER_API_KEY
